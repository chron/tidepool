{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tidepool",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "routes": [
    {
      "pattern": "tidepool.prestidge.dev",
      "custom_domain": true
    }
  ]
}
